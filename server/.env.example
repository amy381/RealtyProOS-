PORT=3001
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
FUB_API_KEY=your_fub_api_key_here

# Shared secret for the Gmail sidebar add-on (api/sidebar/*).
# The Apps Script sends this in the x-sidebar-secret request header. Set the
# real value in Vercel project env vars; this file is documentation only.
SIDEBAR_SECRET=your_long_random_string_here
